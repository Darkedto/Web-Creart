# ─── MongoDB Atlas ───────────────────────────────────────────────────────────
# Obtené tu URI en: https://cloud.mongodb.com → Connect → Drivers
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/creart?retryWrites=true&w=majority

# ─── NextAuth.js ─────────────────────────────────────────────────────────────
# Generá con: openssl rand -base64 32   (o cualquier string aleatorio largo)
NEXTAUTH_SECRET=tu_secret_super_largo_aqui
# En producción: tu dominio de Vercel. En dev: http://localhost:3000
NEXTAUTH_URL=http://localhost:3000

# ─── Stripe ──────────────────────────────────────────────────────────────────
# Encontrás estas claves en: https://dashboard.stripe.com/apikeys
# Usá las claves TEST (pk_test_ / sk_test_) mientras desarrollás
STRIPE_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxx
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxx
# Webhook secret: se genera al crear el webhook en Stripe Dashboard
# En dev usá: stripe listen --forward-to localhost:3000/api/webhooks/stripe
STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxxxxxxxxxx

# ─── App ─────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_WA_NUMBER=50431969913

# ─── Uploadthing (imágenes de productos) ────────────────────────────────────
# Registrá en: https://uploadthing.com → crear app → API Keys
UPLOADTHING_SECRET=sk_live_xxxxxxxxxxxxxxxxxxxxx
UPLOADTHING_APP_ID=xxxxxxxx

# ─── Admin seed (solo para crear el primer admin) ────────────────────────────
SEED_ADMIN_EMAIL=admin@creart.hn
SEED_ADMIN_PASSWORD=CambiaEsta!2026
